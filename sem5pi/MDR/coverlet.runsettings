<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <EnableUserCode>true</EnableUserCode>
            <IncludeTestAssembly>true</IncludeTestAssembly>
            <ExcludeAttributes>Obsolete,GeneratedCode</ExcludeAttributes>
            <UseSourceLinks>true</UseSourceLinks>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
